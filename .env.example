# Osama backend base URL
VITE_API_BASE=http://localhost:5000/api/v1

# true = local stateful mock adapter; false = real backend
VITE_USE_MOCK_API=false

# Log the user out after this many minutes without clicks, keyboard input,
# scrolling or touch activity. Defaults to 30 when omitted.
VITE_SESSION_IDLE_MINUTES=30
